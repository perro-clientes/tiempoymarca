# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Resend: https://resend.com/api-keys (server only)
RESEND_API_KEY=your-resend-api-key

# Remitente de los emails del formulario. Tiene que ser de un dominio verificado en Resend.
# Ej.: "Tiempo & Marca <hola@tudominio.com>"
RESEND_FROM_EMAIL=

# URL pública del sitio, sin barra final (metadataBase, canonical, sitemap y robots).
NEXT_PUBLIC_SITE_URL=https://tudominio.com
